# ==============================================================================
# CLE Society Staff Attendance System - Frontend Production Build Environment
# File location: frontend/.env.production
# Built into static bundle during: npm run build
# ==============================================================================

# Production API Endpoint:
# For own-server deployment behind Nginx reverse proxy:
# Option A (Recommended): Same-origin relative path /api (works on any HTTPS domain)
VITE_API_URL=/api

# Option B: Explicit HTTPS URL of your custom domain
# VITE_API_URL=https://attendance.yourdomain.com/api

# Campus Geolocation Coordinates (Center point for geofence validation)
VITE_CAMPUS_LAT=16.426026
VITE_CAMPUS_LNG=74.589353
