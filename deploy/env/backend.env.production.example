# ==============================================================================
# CLE Society Staff Attendance System - Backend Production Environment Template
# Location on server: /etc/cle-attendance/backend.env (chmod 600, chown cleadmin:cleadmin)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Binding
# ------------------------------------------------------------------------------
# In production behind Nginx reverse proxy, bind to loopback (127.0.0.1)
# so the backend port is never accessible directly from the public internet.
PORT=5001
HOST=127.0.0.1
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Authorized Frontend Origins (CORS)
# ------------------------------------------------------------------------------
# Strict HTTPS domain(s) of your deployed application, comma-separated, without trailing slash.
# Example: https://attendance.clesociety.edu.in
FRONTEND_URL=https://attendance.yourdomain.com

# ------------------------------------------------------------------------------
# 3. Persistent SQLite Database Storage
# ------------------------------------------------------------------------------
# MUST be located outside temporary build and deployment directories.
# Recommended: /var/lib/cle-attendance/database.sqlite
DATABASE_PATH=/var/lib/cle-attendance/database.sqlite

# ------------------------------------------------------------------------------
# 4. Uploaded OD Documents Storage
# ------------------------------------------------------------------------------
# Storage for staff On-Duty (OD) document attachments (PDF, JPEG, PNG).
# Keep on the same persistent volume, outside the public web root.
UPLOAD_DIR=/var/lib/cle-attendance/uploads/od-documents

# ------------------------------------------------------------------------------
# 5. Cryptographic Security Secrets
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret using: openssl rand -hex 32
# Required at server startup. Must be at least 32 characters.
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key_generated_by_openssl

# ------------------------------------------------------------------------------
# 6. Real SMS Gateway Configuration (XSMS Gateway)
# ------------------------------------------------------------------------------
# Credentials provided by your registered SMS aggregator.
# Registered DLT Header: TGSSVM | Approved DLT Template ID: 1507166573508565333
SMS_AUTH_KEY=your_xsms_auth_key_here
SMS_API_KEY=your_xsms_api_key_here
SMS_SENDER=TGSSVM
DLT_TE_ID=1507166573508565333
SMS_BASE_URL=https://m.xsms.in/api/sendhttp.php
SMS_CAMPAIGN=production

# ------------------------------------------------------------------------------
# 7. Fallback SMS Gateway Configuration (Twilio - Optional)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_API_KEY=your_twilio_api_key_here
TWILIO_API_SECRET=your_twilio_api_secret_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# ------------------------------------------------------------------------------
# 8. Campus Geofence Boundary Centroid
# ------------------------------------------------------------------------------
# Center coordinates for campus presence validation (Default: CLE Society Campus)
CAMPUS_LAT=16.426026
CAMPUS_LNG=74.589353
