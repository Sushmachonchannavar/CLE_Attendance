{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://cle-attendance.onrender.com/api/$1"
    },
    {
      "source": "/downloads/(.*)",
      "destination": "https://cle-attendance.onrender.com/downloads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
